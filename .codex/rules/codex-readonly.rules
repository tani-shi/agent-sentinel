prefix_rule(pattern=["codex", "review"], decision="allow")
prefix_rule(pattern=["codex", "execpolicy", "check"], decision="allow")
prefix_rule(pattern=["codex", "features", "list"], decision="allow")
prefix_rule(pattern=["codex", "login", "status"], decision="allow")
prefix_rule(pattern=["codex", "mcp", ["list", "get"]], decision="allow")
prefix_rule(pattern=["codex", "plugin", "list"], decision="allow")
prefix_rule(pattern=["codex", "plugin", "marketplace", "list"], decision="allow")
prefix_rule(pattern=["codex", "doctor"], decision="allow")
prefix_rule(pattern=["codex", "completion"], decision="allow")
prefix_rule(pattern=["codex", ["help", "--help", "-h", "--version", "-V"]], decision="allow")
